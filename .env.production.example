# ApexBiz production compose environment example
# Copy this file to .env.production and replace values before deployment.

POSTGRES_PASSWORD=replace-with-strong-postgres-password
JWT_SECRET=replace-with-a-strong-random-jwt-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-strong-random-refresh-secret-at-least-32-characters
RABBITMQ_DEFAULT_USER=apexbiz_mq
RABBITMQ_DEFAULT_PASS=replace-with-strong-rabbitmq-password
FRONTEND_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
